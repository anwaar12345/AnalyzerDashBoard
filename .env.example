# Copy this file to ".env" (same folder) and fill in your own values.
# .env is ignored by git, so your key is never uploaded with the code.

# Google AI Studio → API Keys → copy your key
GEMINI_API_KEY=your-key-here

# Optional: which Gemini model reads PDF/Word/image files.
# Run "npm run check-ai" to see the models your key can use.
GEMINI_MODEL=gemini-3-flash-preview
# Optional: tried in order when the main model is busy or retired
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Optional: which AI service to use (only "gemini" for now)
AI_PROVIDER=gemini
